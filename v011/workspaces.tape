Output output/workspaces.gif
Require jj

Set Shell "bash"
Set Theme Dracula
Set Padding 0
Set FontSize 16
Set Width 1200
Set Height 640
Set Framerate 24
Set WindowBarSize 0

Hide
Type 'export JJ_CONFIG="$PWD/jj-config.toml" JJUI_CONFIG_DIR="$HOME/demo/jjui-config" && ./init.sh && clear && jjui ~/demo/repo' Enter
Wait /revisions/
Show
Sleep 0.3s
Type "iw"
Sleep 0.5s
Type "J"
Sleep 0.6s
Type "r"
Sleep 0.6s
Sleep 0.3s
Backspace 6
Sleep 0.3s
Type "docs-review"
Sleep 0.5s
Enter
Sleep 0.8s
Sleep 0.3s
Type "s"
Sleep 1.5s
Sleep 0.3s
Sleep 0.5s
Hide
Type "q"
