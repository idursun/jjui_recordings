Output output/object_jump.gif
Require jj

Set Shell "bash"
Set Theme Dracula
Set Padding 0
Set FontSize 16
Set Width 1200
Set Height 640
Set Framerate 24
Set WindowBarSize 0

Hide
Type 'export JJ_CONFIG="$PWD/jj-config.toml" JJUI_CONFIG_DIR="$HOME/demo/jjui-config" && ./init.sh && clear && jjui ~/demo/repo' Enter
Wait /revisions/
Show
Sleep 0.3s
Type "j"
Sleep 0.5s
Type "ib"
Sleep 0.7s
Type "j"
Sleep 0.6s
Type "ia"
Sleep 0.7s
Type "id"
Sleep 0.7s
Type "0"
Sleep 0.6s
Sleep 0.3s
Sleep 1s
Hide
Type "q"
